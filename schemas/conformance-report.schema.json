{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aexcompat.local/schemas/conformance-report.schema.json",
  "title": "AEXCompat conformance bundle report",
  "schema_name": "AEXCompat conformance bundle report schema",
  "schema_version": 1,
  "x-protocol-max-bytes": 16777216,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "identities", "parameters", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "identities": {
      "type": "object", "additionalProperties": false, "required": ["aex", "dependencies", "input", "runner"],
      "properties": {
        "aex": {"$ref": "conformance-manifest.schema.json#/$defs/artifact"},
        "dependencies": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "conformance-manifest.schema.json#/$defs/artifact"}},
        "input": {"$ref": "conformance-manifest.schema.json#/$defs/artifact"},
        "runner": {"$ref": "conformance-manifest.schema.json#/$defs/artifact"}
      }
    },
    "parameters": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/parameter_metadata"}},
    "results": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/depth_result"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rect": {
      "type": "object", "additionalProperties": false, "required": ["left", "top", "right", "bottom"],
      "properties": {"left": {"type": "integer"}, "top": {"type": "integer"}, "right": {"type": "integer"}, "bottom": {"type": "integer"}}
    },
    "world": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "row_bytes", "pixel_format", "premultiplication", "extent_hint"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 65535},
        "height": {"type": "integer", "minimum": 1, "maximum": 65535},
        "row_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "pixel_format": {"enum": ["argb8", "argb16", "argb32f"]},
        "premultiplication": {"enum": ["straight", "premultiplied", "opaque"]},
        "extent_hint": {"$ref": "#/$defs/rect"}
      }
    },
    "selector": {
      "type": "object", "additionalProperties": false, "required": ["render_path", "completed", "error_code"],
      "properties": {"render_path": {"enum": ["classic", "smartfx"]}, "completed": {"type": "boolean"}, "error_code": {"type": ["integer", "null"]}}
    },
    "parameter_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "type", "initial_value", "host_range", "user_range"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 65535},
        "type": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_ -]+$"},
        "initial_value": {"$ref": "conformance-manifest.schema.json#/$defs/json_value"},
        "host_range": {"$ref": "#/$defs/range"},
        "user_range": {"$ref": "#/$defs/range"}
      }
    },
    "range": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "number"}, "maximum": {"type": "number"}}}
      ]
    },
    "suite_event": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "action", "name", "version", "selector", "result"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "action": {"enum": ["acquire", "release"]},
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9 _-]{0,62}[A-Za-z0-9]$"},
        "version": {"type": "integer", "minimum": 1, "maximum": 65535},
        "selector": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_ -]+$"},
        "result": {"type": "integer"}
      }
    },
    "oracle": {
      "type": "object", "additionalProperties": false, "required": ["state", "identity_match", "exact"],
      "properties": {
        "state": {"enum": ["not_requested", "not_captured", "captured"]},
        "identity_match": {"type": "boolean"}, "exact": {"type": "boolean"},
        "expected_sha256": {"$ref": "#/$defs/sha256"}, "actual_sha256": {"$ref": "#/$defs/sha256"},
        "mismatched_pixels": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      },
      "allOf": [
        {"if": {"properties": {"exact": {"const": true}}, "required": ["exact"]}, "then": {"required": ["expected_sha256", "actual_sha256", "mismatched_pixels"], "properties": {"state": {"const": "captured"}, "identity_match": {"const": true}, "mismatched_pixels": {"const": 0}}}},
        {"if": {"properties": {"state": {"const": "captured"}}, "required": ["state"]}, "then": {"required": ["expected_sha256", "actual_sha256", "mismatched_pixels"]}, "else": {"properties": {"identity_match": {"const": false}, "exact": {"const": false}}, "not": {"anyOf": [{"required": ["expected_sha256"]}, {"required": ["actual_sha256"]}, {"required": ["mismatched_pixels"]}] }}},
        {"if": {"properties": {"identity_match": {"const": false}}, "required": ["identity_match"]}, "then": {"properties": {"exact": {"const": false}}}}
      ]
    },
    "depth_result": {
      "type": "object", "additionalProperties": false,
      "required": ["depth", "classification", "selector", "input_world", "world", "raw_input", "raw_output", "output_sha256", "suite_timeline", "oracle"],
      "properties": {
        "depth": {"enum": ["argb8", "argb16", "argb32f"]},
        "classification": {"enum": ["ok", "unsupported", "selector_error", "missing_suite", "nonzero_exit", "crashed", "timeout_killed", "invalid_output", "host_validation_error"]},
        "selector": {"$ref": "#/$defs/selector"},
        "input_world": {"$ref": "#/$defs/world"},
        "world": {"oneOf": [{"$ref": "#/$defs/world"}, {"type": "null"}]},
        "raw_input": {"$ref": "conformance-manifest.schema.json#/$defs/artifact"},
        "raw_output": {"oneOf": [{"$ref": "conformance-manifest.schema.json#/$defs/artifact"}, {"type": "null"}]},
        "output_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "suite_timeline": {"oneOf": [{"type": "array", "maxItems": 65536, "items": {"$ref": "#/$defs/suite_event"}}, {"type": "null"}]},
        "missing_suites": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9 _-]{0,62}[A-Za-z0-9]$"}, "version": {"type": "integer", "minimum": 1, "maximum": 65535}}}},
        "oracle": {"$ref": "#/$defs/oracle"}
      },
      "allOf": [
        {"if": {"properties": {"classification": {"const": "ok"}}, "required": ["classification"]}, "then": {"properties": {"world": {"$ref": "#/$defs/world"}, "raw_output": {"$ref": "conformance-manifest.schema.json#/$defs/artifact"}, "output_sha256": {"$ref": "#/$defs/sha256"}, "selector": {"properties": {"completed": {"const": true}, "error_code": {"const": 0}}}}}},
        {"if": {"properties": {"classification": {"const": "missing_suite"}}, "required": ["classification"]}, "then": {"required": ["missing_suites"], "properties": {"missing_suites": {"minItems": 1}}}}
      ]
    }
  }
}
