{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aexcompat.local/schemas/real-aex-triage.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","inventory_sha256","matrix_sha256","results","missing_suite_aggregation"],
  "properties":{"schema_version":{"const":1},"inventory_sha256":{"$ref":"#/$defs/sha"},"matrix_sha256":{"$ref":"#/$defs/sha"},"results":{"type":"array","items":{"$ref":"#/$defs/result"}},"missing_suite_aggregation":{"type":"array","items":{"$ref":"#/$defs/aggregate"}}},
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{"type":"object","additionalProperties":false,"required":["role","sha256","size_bytes"],"properties":{"role":{"type":"string","pattern":"^[a-z]+(?:-[0-9]{3})?$"},"sha256":{"$ref":"#/$defs/sha"},"size_bytes":{"type":"integer","minimum":0}}},
    "suite":{"type":"object","additionalProperties":false,"required":["name","version"],"properties":{"name":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9 _-]{0,62}[A-Za-z0-9]$"},"version":{"type":"integer","minimum":1,"maximum":65535}}},
    "identities":{"type":"object","additionalProperties":false,"required":["aex","dependencies","input","runner","workers"],"properties":{"aex":{"$ref":"#/$defs/artifact"},"dependencies":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/artifact"}},"input":{"$ref":"#/$defs/artifact"},"runner":{"$ref":"#/$defs/artifact"},"workers":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/artifact"}}}},
    "result":{"type":"object","additionalProperties":false,"required":["case_id","plugin_id","plugin_sha256","render_path","depth","time","parameter_set_index","classification","selector_error_code","missing_suites","private_report_path","private_report_sha256","identities"],"properties":{"case_id":{"type":"string","pattern":"^case-[0-9]{6}$"},"plugin_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"plugin_sha256":{"$ref":"#/$defs/sha"},"render_path":{"enum":["classic","smartfx"]},"depth":{"enum":["argb8","argb16","argb32f"]},"time":{"type":"object","additionalProperties":false,"required":["value","scale"],"properties":{"value":{"type":"integer"},"scale":{"type":"integer","minimum":1}}},"parameter_set_index":{"type":"integer","minimum":0},"classification":{"enum":["ok","loader_error","selector_error","missing_suite","host_validation_error","crashed","timeout"]},"selector_error_code":{"type":["integer","null"]},"missing_suites":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/suite"}},"private_report_path":{"type":"string","pattern":"^evidence/case-[0-9]{6}/report\\.json$"},"private_report_sha256":{"$ref":"#/$defs/sha"},"identities":{"$ref":"#/$defs/identities"}}},
    "aggregate":{"type":"object","additionalProperties":false,"required":["suite_id","version","distinct_aex_sha_count"],"properties":{"suite_id":{"type":"string","pattern":"^suite-[0-9a-f]{20}$"},"version":{"type":"integer","minimum":1,"maximum":65535},"distinct_aex_sha_count":{"type":"integer","minimum":1}}}
  }
}
