{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aexcompat.local/schemas/real-aex-gaps.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","corpus_shape","matrix_shape","records","missing_suite_aggregation"],
  "properties":{"schema_version":{"const":1},"corpus_shape":{"type":"object","additionalProperties":false,"required":["aex_count","supplier_count"],"properties":{"aex_count":{"type":"integer","minimum":5},"supplier_count":{"type":"integer","minimum":3}}},"matrix_shape":{"type":"object","additionalProperties":false,"required":["render_path_count","depth_count","time_count","parameter_shape_count"],"properties":{"render_path_count":{"const":2},"depth_count":{"const":3},"time_count":{"type":"integer","minimum":1},"parameter_shape_count":{"type":"integer","minimum":1}}},"records":{"type":"array","items":{"$ref":"#/$defs/record"}},"missing_suite_aggregation":{"type":"array","items":{"$ref":"#/$defs/aggregate"}}},
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "time":{"type":"object","additionalProperties":false,"required":["value","scale"],"properties":{"value":{"type":"integer"},"scale":{"type":"integer","minimum":1}}},
    "shape":{"type":"array","maxItems":1024,"items":{"type":"object","additionalProperties":false,"required":["index","type"],"properties":{"index":{"type":"integer","minimum":0,"maximum":65535},"type":{"enum":["angle","checkbox","color","float","integer","layer","point","popup","slider"]}}}},
    "suite":{"type":"object","additionalProperties":false,"required":["suite_id","version"],"properties":{"suite_id":{"type":"string","pattern":"^suite-[0-9a-f]{20}$"},"version":{"type":"integer","minimum":1,"maximum":65535},"canonical_name":{"enum":["PF World Suite","PF Iterate8 Suite","PF iterate16 Suite","PF iterateFloat Suite","PF Pixel Data Suite","PF World Transform Suite","PF Fill Matte Suite","PF Path Data Suite","PF Path Query Suite","PF Sampling8 Suite","PF Sampling16 Suite","PF SamplingFloat Suite","PF Param Utils Suite","PF Effect UI Suite","PF AE Channel Suite","AEGP Item Suite","AEGP Comp Suite","AEGP Layer Suite","AEGP Effect Suite","AEGP Stream Suite","AEGP Render Suite"]}}},
    "artifact":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^evidence/gap-[0-9]{6}\\.json$"},"sha256":{"$ref":"#/$defs/sha"}}},
    "replay":{"type":"array","minItems":18,"maxItems":18,"prefixItems":[{"const":"python"},{"const":"tools/run-real-aex-corpus.py"},{"const":"--inventory"},{"const":"<PUBLIC_INVENTORY>"},{"const":"--locator"},{"const":"<PRIVATE_LOCATOR>"},{"const":"--matrix"},{"const":"<MATRIX>"},{"const":"--runner"},{"const":"<PINNED_RUNNER>"},{"const":"--input"},{"const":"<INPUT>"},{"const":"--out"},{"const":"<NEW_PUBLIC_OUT>"},{"const":"--private-evidence-out"},{"const":"<NEW_PRIVATE_OUT>"},{"const":"--case-list"},{"const":"<PRIVATE_CASE_LIST>"}],"items":false},
    "record":{"type":"object","additionalProperties":false,"required":["gap_id","occurrence_count","render_path","depth","time","parameter_shape","classification","stage","error_code","missing_suites","evidence","replay"],"properties":{"gap_id":{"type":"string","pattern":"^gap-[0-9]{6}$"},"occurrence_count":{"type":"integer","minimum":1},"render_path":{"enum":["classic","smartfx"]},"depth":{"enum":["argb8","argb16","argb32f"]},"time":{"$ref":"#/$defs/time"},"parameter_shape":{"$ref":"#/$defs/shape"},"classification":{"enum":["loader_error","selector_error","missing_suite","host_validation_error","crashed","timeout"]},"stage":{"enum":["loader","selector","suite","host_validation","process"]},"error_code":{"type":["integer","null"]},"missing_suites":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/suite"}},"evidence":{"$ref":"#/$defs/artifact"},"replay":{"$ref":"#/$defs/replay"}}},
    "aggregate":{"type":"object","additionalProperties":false,"required":["suite_id","version","distinct_aex_sha_count"],"properties":{"suite_id":{"type":"string","pattern":"^suite-[0-9a-f]{20}$"},"version":{"type":"integer","minimum":1,"maximum":65535},"distinct_aex_sha_count":{"type":"integer","minimum":1}}}
  }
}
