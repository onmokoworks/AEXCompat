{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aexcompat.local/schemas/real-aex-locator.schema.json",
  "title": "Machine-local AEX corpus locator (never committed)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "plugins": {
      "type": "object", "minProperties": 1, "maxProperties": 128,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["source_root", "aex"],
        "properties": {
          "source_root": {"type": "string", "minLength": 3, "maxLength": 1024},
          "aex": {"$ref": "#/$defs/artifact"},
          "dependencies": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[^/]*[. ](?:/|$))[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776}
      }
    }
  }
}
