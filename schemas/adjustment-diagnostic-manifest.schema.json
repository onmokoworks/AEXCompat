{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aexcompat.local/schemas/adjustment-diagnostic-manifest.schema.json",
  "title": "AEXCompat direct/adjustment diagnostic manifest",
  "schema_name": "AEXCompat Adjustment Layer diagnostic manifest schema",
  "schema_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnostic_id", "plugin", "runner", "requested_depths", "execution", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "diagnostic_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "plugin": {
      "type": "object", "additionalProperties": false, "required": ["aex", "dependencies"],
      "properties": {
        "aex": {"$ref": "conformance-manifest.schema.json#/$defs/artifact"},
        "dependencies": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "conformance-manifest.schema.json#/$defs/artifact"}}
      }
    },
    "runner": {"$ref": "conformance-manifest.schema.json#/$defs/artifact"},
    "requested_depths": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["argb8", "argb16", "argb32f"]}},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["render_path", "time", "parameters", "resolution", "downsample", "premultiplication", "alpha_policy", "color_management", "linear_light", "renderer"],
      "properties": {
        "render_path": {"enum": ["classic", "smartfx"]},
        "time": {"type": "object", "additionalProperties": false, "required": ["value", "scale"], "properties": {"value": {"type": "integer", "minimum": 0, "maximum": 10000000}, "scale": {"type": "integer", "minimum": 1, "maximum": 1000000}}},
        "parameters": {"type": "array", "maxItems": 1024, "items": {"$ref": "conformance-manifest.schema.json#/$defs/parameter_value"}},
        "resolution": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1, "maximum": 65535}, "height": {"type": "integer", "minimum": 1, "maximum": 65535}}},
        "downsample": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "integer", "minimum": 1, "maximum": 16}, "y": {"type": "integer", "minimum": 1, "maximum": 16}}},
        "premultiplication": {"enum": ["straight", "premultiplied", "opaque"]},
        "alpha_policy": {"enum": ["straight", "premultiplied", "opaque"]},
        "color_management": {"type": "object", "additionalProperties": false, "required": ["enabled", "working_space"], "properties": {"enabled": {"const": false}, "working_space": {"type": "null"}}},
        "linear_light": {"const": false},
        "renderer": {"enum": ["AEXCompat CPU", "software"]}
      }
    },
    "sources": {
      "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "artifact", "role"], "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "artifact": {"$ref": "conformance-manifest.schema.json#/$defs/artifact"},
        "role": {"enum": ["opaque_full_frame", "alpha_material"]}
      }}
    }
  }
}
