{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aexcompat.local/schemas/conformance-manifest.schema.json",
  "title": "AEXCompat conformance bundle manifest",
  "schema_name": "AEXCompat conformance bundle manifest schema",
  "schema_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "plugin", "input", "runner", "requested_depths", "execution", "oracle"],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aex", "dependencies"],
      "properties": {
        "aex": {"$ref": "#/$defs/artifact"},
        "dependencies": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "input": {"$ref": "#/$defs/artifact"},
    "runner": {"$ref": "#/$defs/artifact"},
    "requested_depths": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": {"enum": ["argb8", "argb16", "argb32f"]}
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "parameters", "premultiplication", "color_management", "linear_light", "renderer"],
      "properties": {
        "time": {
          "type": "object", "additionalProperties": false, "required": ["value", "scale"],
          "properties": {"value": {"type": "integer"}, "scale": {"type": "integer", "minimum": 1, "maximum": 2147483647}}
        },
        "parameters": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/parameter_value"}},
        "premultiplication": {"enum": ["straight", "premultiplied", "opaque"]},
        "color_management": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "working_space"],
          "properties": {"enabled": {"type": "boolean"}, "working_space": {"type": ["string", "null"], "maxLength": 256}}
        },
        "linear_light": {"type": "boolean"},
        "renderer": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._ -]+$"}
      }
    },
    "oracle": {
      "type": "object", "additionalProperties": false, "required": ["state", "identity_match"],
      "properties": {
        "state": {"enum": ["not_requested", "not_captured", "captured"]},
        "identity_match": {"type": "boolean"},
        "artifacts": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "argb8": {"$ref": "#/$defs/artifact"},
            "argb16": {"$ref": "#/$defs/artifact"},
            "argb32f": {"$ref": "#/$defs/artifact"}
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"state": {"const": "captured"}}, "required": ["state"]},
        "then": {"required": ["artifacts"]},
        "else": {"properties": {"identity_match": {"const": false}}, "not": {"required": ["artifacts"]}}
      }]
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string", "minLength": 1, "maxLength": 240,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[^/]*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776}
      }
    },
    "json_value": {
      "oneOf": [
        {"type": ["number", "string", "boolean"]},
        {"type": "array", "maxItems": 16, "items": {"type": "number"}}
      ]
    },
    "parameter_value": {
      "type": "object", "additionalProperties": false, "required": ["index", "type", "value"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 65535},
        "type": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_ -]+$"},
        "value": {"$ref": "#/$defs/json_value"}
      }
    }
  }
}
