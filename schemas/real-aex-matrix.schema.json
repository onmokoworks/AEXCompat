{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aexcompat.local/schemas/real-aex-matrix.schema.json",
  "title": "AEXCompat real Effect AEX common matrix",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "render_paths", "depths", "times", "parameter_sets"],
  "properties": {
    "schema_version": {"const": 1},
    "render_paths": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "contains": {"const": "classic"}, "items": {"enum": ["classic", "smartfx"]}},
    "depths": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["argb8", "argb16", "argb32f"]}},
    "times": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["value", "scale"], "properties": {"value": {"type": "integer", "minimum": 0, "maximum": 10000000}, "scale": {"type": "integer", "minimum": 1, "maximum": 1000000}}}},
    "parameter_sets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "array", "maxItems": 1024, "items": {"type": "object", "additionalProperties": false, "required": ["index", "type", "value"], "properties": {"index": {"type": "integer", "minimum": 0, "maximum": 65535}, "type": {"enum": ["angle", "checkbox", "color", "float", "integer", "layer", "point", "popup", "slider"]}, "value": {"oneOf": [{"type": ["number", "string", "boolean"]}, {"type": "array", "maxItems": 16, "items": {"type": "number"}}]}}}}}
  }
}
