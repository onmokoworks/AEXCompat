<?xml version="1.0" encoding="UTF-8"?>
<!-- SPIKE_COMMENT_SENTINEL: comments must survive the preservation writer spike -->
<xmp:project xmlns:xmp="urn:aviutlas:synthetic:aepx" xmlns:meta="urn:aviutlas:synthetic:meta" meta:UNKNOWN_ATTR_SENTINEL="keep">
  <xmp:comp data-id="comp-main" display-name="Main" id="comp-main" name="Main">
    <xmp:layer id="layer-text" name="Text Layer">
      <xmp:text><![CDATA[SPIKE_CDATA_SENTINEL <raw>&value</raw>]]></xmp:text>
    </xmp:layer>
        <xmp:UNKNOWN_NODE_SENTINEL oddSpacing = "  keep  ">
          <meta:child meta:prefixAttr="SPIKE_PREFIX_ATTR_SENTINEL"/>
        </xmp:UNKNOWN_NODE_SENTINEL>
  </xmp:comp>
  <prefix:PREFIX_SENTINEL xmlns:prefix="urn:aviutlas:synthetic:prefix"/>
</xmp:project>
