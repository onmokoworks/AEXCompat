<?xml version="1.0" encoding="UTF-8"?>
<!-- CRLF_BOM_COMMENT_SENTINEL: CRLF and UTF-8 BOM should survive span replacement -->
<xmp:project xmlns:xmp="urn:aviutlas:synthetic:aepx" xmlns:meta="urn:aviutlas:synthetic:meta" meta:CRLF_BOM_ATTR_SENTINEL="keep">
  <xmp:comp id="comp-crlf-bom" name="CRLF Main" data-id="comp-crlf-bom" display-name="CRLF Main">
    <xmp:layer id="layer-crlf" name="CRLF Layer">
      <xmp:text><![CDATA[CRLF_BOM_CDATA_SENTINEL <raw>&value</raw>]]></xmp:text>
    </xmp:layer>
    <xmp:CRLF_BOM_NODE_SENTINEL meta:note="keep"/>
  </xmp:comp>
</xmp:project>
