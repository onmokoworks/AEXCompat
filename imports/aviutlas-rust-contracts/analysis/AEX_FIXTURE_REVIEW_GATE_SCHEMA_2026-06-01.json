{
  "schema_name": "AEX fixture review gate schema",
  "schema_version": 1,
  "artifact": "analysis/AEX_FIXTURE_REVIEW_GATE_2026-05-31.json",
  "purpose": "Machine-check the local-only fixture review queue before any future AEX worker loader slice.",
  "required_fields": [
    "schema_version",
    "name",
    "publication_status",
    "status",
