{
  "schema_name": "AEX static classifier catalog report schema",
  "schema_version": 1,
  "artifact": "aviutl-rs/target/aex-static-classifier/catalog.local.json",
  "purpose": "Machine-check the default metadata-only AEX classifier catalog emitted without binary, source, loader, worker, render, hash, or payload capture.",
  "evidence_mode": "default-no-binary-open-static-metadata",
  "default_options": {
    "inspect_pe": false,
    "inspect_adjacent_source": false
  },
  "required_fields": [
    "schema_version",
    "catalog_id",
    "publication_status",
    "status",
    "generated_by",
    "input",
    "notes",
    "effects"
  ],
  "required_values": {
    "schema_version": 1,
    "catalog_id": "external-effects-local",
    "publication_status": "local-only",
    "status": "metadata-only-static-inference",
    "generated_by": "aex_static_classifier"
  },
  "input_required_fields": [
    "schema_version",
    "publication_status",
    "safety_notes"
  ],
  "required_notes": [
    "Classifications are inferred from inventory path/extension/metadata only.",
    "No .aex file was opened, hashed, loaded, or executed.",
    "PE headers, exports, resources, and PiPL fields are not inspected in this slice.",
    "Records are not render-capable until a reviewed worker/probe path verifies support."
  ],
  "effect_required_fields": [
    "schema_version",
    "effect_id",
    "path",
    "size",
    "source",
    "identity",
    "classification",
    "params",
    "frame",
    "host_surfaces",
    "execution",
    "risk",
    "last_probe",
    "pe_machine",
    "exports",
    "resource_summary",
    "pipl_resource_status",
    "pipl_resource_entries",
    "pipl_content_scan",
    "pipl_kind",
    "pipl_name",
    "pipl_category",
    "pipl_match_name",
    "entrypoint",
    "adjacent_source_tree",
    "adjacent_license",
    "fixture_status",
    "inferred_class",
    "plugin_class",
    "status",
    "confidence",
    "evidence",
    "blocked_reasons",
    "deferred_features",
    "recommended_next_action",
    "render_capable",
    "notes"
  ],
  "effect_required_values": {
    "schema_version": 1,
    "params": [],
    "last_probe": null,
    "pe_machine": null,
    "exports": [],
