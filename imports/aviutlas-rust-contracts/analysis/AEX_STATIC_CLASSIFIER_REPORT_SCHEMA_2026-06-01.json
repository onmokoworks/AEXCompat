    "frame_index",
    "time_seconds"
  ],
  "time_model_required_values": {
    "mode": "single-frame",
    "frame_index": 0,
    "time_seconds": 0.0
  },
  "host_surfaces_required_fields": [
    "aex_worker",
    "aviutlas_external_effect",
    "ofx_facade"
  ],
  "host_surface_required_fields": [
    "supported",
    "status"
  ],
  "host_surface_required_values": {
