    "preferred_pixel_format": "rgba8",
    "alpha": "unknown",
    "color_management": "none-claimed",
    "max_width": 4096,
    "max_height": 4096,
    "transport": [
      "png-v0"
    ]
  },
  "time_model_required_fields": [
