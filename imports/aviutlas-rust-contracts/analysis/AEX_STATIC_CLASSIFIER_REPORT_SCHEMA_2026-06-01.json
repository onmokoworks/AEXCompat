      "truncated": false,
      "contents_emitted": false,
      "matched_fields": [],
      "unmatched_expected_fields": [],
      "notes": [
        "PiPL content scan was not requested.",
        "No PiPL resource contents were read."
      ]
    },
    "render_capable": false
  },
  "pipl_content_scan_required_fields": [
    "status",
    "scan_mode",
    "bytes_limit",
    "bytes_read",
    "truncated",
    "contents_emitted",
    "matched_fields",
    "unmatched_expected_fields",
    "notes"
  ],
  "pipl_content_scan_default_values": {
    "status": "not_requested",
    "scan_mode": "disabled",
    "bytes_limit": 0,
    "bytes_read": 0,
    "truncated": false,
    "contents_emitted": false,
    "matched_fields": [],
    "unmatched_expected_fields": []
