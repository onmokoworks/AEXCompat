    ],
    "ofx_facade": [
      "future"
    ]
  },
  "execution_required_fields": [
    "load_status",
    "allowlist_status",
    "worker_required",
    "broker_may_load_plugin",
    "selectors",
    "required_suites",
    "unsupported"
  ],
  "execution_required_values": {
    "load_status": "not_loaded",
    "worker_required": true,
    "broker_may_load_plugin": false,
    "required_suites": []
  },
  "execution_selector_required_fields": [
    "name",
    "status",
    "evidence"
  ],
  "risk_required_fields": [
    "cleanroom",
    "license",
    "publication",
    "notes"
  ],
  "risk_required_values": {
    "cleanroom": "local-only",
    "publication": "do-not-publish-binary"
  },
  "allowed_effect_statuses": [
    "classified_from_inventory",
    "classified_from_adjacent_source",
    "classified_from_pipl_resource",
    "unknown_needs_resource_scan",
    "blocked_aegp",
    "defer_heavy_dependency",
    "defer_smartfx_only",
    "candidate_for_contract_probe"
  ],
  "status_vocabulary": {
    "candidate": [
      "candidate_for_contract_probe",
      "classified_from_inventory"
    ],
    "deferred": [
      "defer_heavy_dependency",
      "defer_smartfx_only",
      "unknown_needs_resource_scan"
    ],
    "blocked": [
      "blocked_aegp"
    ],
    "future_read_only_metadata": [
      "classified_from_adjacent_source",
      "classified_from_pipl_resource"
    ]
  },
  "required_default_status_coverage": [
    "candidate_for_contract_probe",
    "classified_from_inventory",
    "blocked_aegp",
    "defer_heavy_dependency",
    "unknown_needs_resource_scan"
  ],
  "allowed_plugin_classes": [
    "classic-effect-candidate",
    "aegp",
    "blocked",
    "unknown"
  ],
  "allowed_confidences": [
    "inferred",
    "unverified"
  ],
  "allowed_allowlist_statuses": [
    "required",
    "denied"
  ],
  "allowed_selector_statuses": [
    "not_run"
  ],
  "allowed_risk_licenses": [
    "candidate-needs-review",
    "unknown"
  ],
  "no_execution_invariants": {
    "native_aex_load_performed": false,
    "effect_entrypoint_called": false,
    "render_performed": false,
    "pixel_parity_measured": false,
    "hash_captured": false,
    "payload_captured": false,
    "external_process_started": false
  },
  "forbidden_fields": [
    "hash",
    "sha1",
    "sha256",
    "sha512",
    "md5",
    "digest",
    "file_hash",
    "file_digest",
    "binary_payload",
    "base64_payload",
    "payload_bytes",
    "payload_hash",
    "binary_bytes",
    "rendered_pixels",
    "pixel_hash",
    "input_png",
    "output_png",
    "worker_exe",
    "native_load_result"
  ],
  "forbidden_serialized_tokens": [
    "sha256",
    "base64"
  ],
  "notes": [
    "This sidecar pins the default classifier report only: inspect_pe=false and inspect_adjacent_source=false.",
    "Optional PE inspection may report PiPL resource id/language/size/codepage metadata, but resource contents must remain unread.",
    "Optional PiPL content scanning is opt-in, bounded, semantic-only, and must not emit raw bytes, hashes, base64, unknown properties, or SDK layouts.",
    "Static entrypoint names may appear as metadata, but selectors must stay not_run and verified_from_binary must stay false.",
    "No native .aex load, EffectMain call, render, pixel parity, hash capture, payload capture, or external worker process is part of this contract."
  ]
}
