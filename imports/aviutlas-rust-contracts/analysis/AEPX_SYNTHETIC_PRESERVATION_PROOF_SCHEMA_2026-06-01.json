{
  "schema_name": "AEPX synthetic preservation proof schema",
  "schema_version": 1,
  "publication_status": "local-only synthetic proof artifact",
  "artifact": "target/aepx-synthetic-preservation-proof/proof.local.json",
  "purpose": "Report a narrow synthetic-only AEPX XML preservation proof before any production AEPX apply writer is enabled.",
  "producer": {
    "path": "aviutl-rs/examples/aepx_synthetic_preservation_proof.rs",
    "production_aepx_apply_enabled": false,
    "after_effects_invoked": false,
    "external_process_invoked": false
  },
  "request_boundary": {
    "synthetic_fixture_only": true,
    "allowed_fixture_names": [
      "aepx_writer_spike_preservation.aepx",
      "aepx_writer_spike_ambiguous.aepx",
      "aepx_writer_spike_scanner_edges.aepx",
      "aepx_writer_spike_duplicate_id.aepx",
      "aepx_writer_spike_unicode_edges.aepx",
      "aepx_writer_spike_multi_comp.aepx",
      "aepx_writer_spike_crlf_bom.aepx"
    ],
    "supported_ready_operation": "rename_comp",
    "supported_ready_selector_kind": "xml_id",
    "required_output_root": "target/aepx-synthetic-preservation-proof",
    "create_new_only": true,
    "preserve_unknown_xml": "required",
    "report_private_payloads": false
  },
  "multi_operation_boundary": {
    "supported": true,
    "max_operations": 4,
    "supported_ready_operation": "rename_comp",
    "supported_ready_selector_kind": "xml_id",
    "all_operations_resolved_before_write": true,
    "approved_spans_must_not_overlap": true,
    "write_if_any_operation_fails": false,
    "apply_replacements_in_reverse_span_order": true
  },
  "report_output_boundary": {
    "required_output_root": "target/aepx-synthetic-preservation-proof",
    "required_extension": ".json",
    "create_new_only": true,
    "path_traversal_allowed": false,
    "canonical_parent_must_resolve_under_output_root": true,
    "private_report_paths_allowed": false
  },
  "optional_path_escape_fixture_boundary": {
    "windows_symlink_parent_escape_test": "opportunistic_skip_if_symlink_creation_is_unavailable",
    "windows_junction_parent_escape_test": "opportunistic_skip_if_junction_creation_is_unavailable",
    "expected_block_status": "write_failed",
    "outside_target_file_created": false,
    "private_escape_paths_embedded_in_report": false
  },
  "crlf_bom_fixture_boundary": {
    "fixture_name": "aepx_writer_spike_crlf_bom.aepx",
    "utf8_bom_required": true,
    "crlf_line_endings_required": true,
    "utf8_bom_preserved_after_write": true,
    "crlf_line_endings_preserved_after_write": true,
    "fixture_values_embedded_in_report": false
  },
  "required_fields": [
    "schema_version",
    "report_kind",
    "publication_status",
    "status",
    "synthetic_fixture_only",
    "proof_mode",
    "operation_kind",
    "selector_kind",
    "target_count",
    "preservation",
    "io_gate",
    "write_gate",
    "hardening_gate",
    "privacy_gate",
    "blocked_reasons",
    "notes"
  ],
  "required_values": {
    "schema_version": 1,
    "report_kind": "aepx_synthetic_preservation_proof",
    "publication_status": "local-only-synthetic-fixture",
    "synthetic_fixture_only": true,
    "proof_mode": "exact_id_span_splice_synthetic_only"
  },
  "allowed_statuses": [
    "synthetic_preservation_proof_ready",
    "invalid_request",
    "target_not_found",
    "ambiguous_target",
    "expected_value_mismatch",
    "output_exists",
    "preservation_failed",
    "parse_error",
    "write_failed"
  ],
  "ready_required_values": {
    "status": "synthetic_preservation_proof_ready",
    "operation_kind": "rename_comp",
    "selector_kind": "xml_id",
    "target_count": 1
  },
  "preservation_required_fields": [
    "unknown_nodes",
    "unknown_attributes",
    "xml_declaration",
    "encoding",
    "comments",
    "cdata",
    "namespace_prefixes",
    "whitespace"
  ],
  "preservation_ready_required_values": {
    "unknown_nodes": "preserved",
    "unknown_attributes": "preserved",
    "xml_declaration": "preserved",
    "encoding": "preserved",
    "comments": "preserved",
    "cdata": "preserved",
    "namespace_prefixes": "preserved",
    "whitespace": "preserved"
  },
  "io_gate_required_values": {
    "synthetic_xml_body_read_performed": true,
    "xml_body_embedded_in_report": false,
    "private_payloads_embedded_in_report": false,
    "external_process_invoked": false,
    "after_effects_invoked": false
  },
  "write_gate_ready_required_values": {
    "output_write_performed": true,
    "output_write_mode": "create_new_synthetic_target_only",
    "output_under_generated_target_root": true,
    "source_overwrite_performed": false,
    "production_apply_enabled": false
  },
  "hardening_gate_required_fields": [
    "output_path_extension_aepx",
    "output_path_has_no_parent_traversal",
    "output_path_under_generated_target_root",
    "output_parent_canonical_under_generated_target_root",
    "replacement_value_xml_safe",
    "exact_byte_diff_verified",
    "all_operations_resolved_before_write",
    "approved_spans_non_overlapping",
    "approved_span_count"
  ],
  "hardening_gate_ready_required_values": {
    "output_path_extension_aepx": true,
    "output_path_has_no_parent_traversal": true,
    "output_path_under_generated_target_root": true,
    "output_parent_canonical_under_generated_target_root": true,
    "replacement_value_xml_safe": true,
    "exact_byte_diff_verified": true,
    "all_operations_resolved_before_write": true,
    "approved_spans_non_overlapping": true,
    "approved_span_count": 1
  },
  "privacy_gate_required_values": {
    "input_path_embedded": false,
    "output_path_embedded": false,
    "selector_value_embedded": false,
    "expected_old_value_embedded": false,
    "new_value_embedded": false,
    "xml_sentinels_embedded": false,
    "xml_body_embedded": false
  },
  "forbidden_serialized_tokens": [
    "SPIKE_COMMENT_SENTINEL",
    "UNKNOWN_NODE_SENTINEL",
    "UNKNOWN_ATTR_SENTINEL",
    "SPIKE_CDATA_SENTINEL",
    "PREFIX_SENTINEL",
    "comp-main",
    "Main Reviewed",
    "Wrong Old",
    "aepx_writer_spike_preservation.aepx",
    "aepx_writer_spike_scanner_edges.aepx",
    "aepx_writer_spike_duplicate_id.aepx",
    "aepx_writer_spike_unicode_edges.aepx",
    "aepx_writer_spike_multi_comp.aepx",
    "aepx_writer_spike_crlf_bom.aepx",
    "target/aepx-synthetic-preservation-proof",
    "EDGE_COMMENT_SENTINEL",
    "EDGE_CDATA_SENTINEL",
    "EDGE_NODE_SENTINEL",
    "EDGE_ATTR_SENTINEL",
    "UNICODE_COMMENT_SENTINEL",
    "UNICODE_CDATA_SENTINEL",
    "UNICODE_ATTR_SENTINEL",
    "UNKNOWN_UNICODE_NODE_SENTINEL",
    "MULTI_COMMENT_SENTINEL",
    "MULTI_ATTR_SENTINEL",
    "MULTI_UNKNOWN_NODE_SENTINEL",
    "CRLF_BOM_COMMENT_SENTINEL",
    "CRLF_BOM_NODE_SENTINEL",
    "CRLF_BOM_CDATA_SENTINEL",
    "CRLF_BOM_ATTR_SENTINEL",
    "comp-unicode",
    "comp-one",
    "comp-two",
    "comp-crlf-bom",
    "メイン",
    "メイン レビュー済み",
    "こんにちは世界",
    "保持値",
    "One Reviewed",
    "Two Reviewed",
    "CRLF Main",
    "CRLF Reviewed",
    ".ffx",
    ".aex",
    "D:/private",
    "C:\\"
  ],
  "required_notes": [
    "Synthetic preservation proof reads checked-in synthetic fixtures only.",
    "The proof is not production AEPX apply and does not claim AE round-trip compatibility.",
    "The report omits XML bodies, selector values, expected values, new values, sentinels, and paths.",
    "After Effects is not launched and no external process is invoked.",
    "The proof verifies exact byte-diff preservation outside the approved replacement span.",
    "CLI report output must be a create-new JSON file under the synthetic proof target root.",
    "Multi-operation proof resolves all spans and rejects overlaps before writing."
  ],
  "non_goals": [
    "not a production AEPX writer",
    "not evidence of After Effects round-trip compatibility",
    "not permission to write private user projects",
    "not permission to enable binary AEP writing",
    "not permission to execute JSX or launch After Effects"
  ]
}
