<?xml version="1.0" encoding="UTF-8"?>
<!-- COMMENT_SENTINEL: unknown comments must not be silently rewritten -->
<xmp:project xmlns:xmp="urn:aviutlas:test:xmp" xmp:UNKNOWN_ATTR_SENTINEL="keep">
  <xmp:comp id="comp-1" name="Main">
        <xmp:UNKNOWN_NODE_SENTINEL oddSpacing = "  keep  ">
          <![CDATA[CDATA_SENTINEL <raw>&value</raw>]]>
        </xmp:UNKNOWN_NODE_SENTINEL>
  </xmp:comp>
  <prefix:PREFIX_SENTINEL xmlns:prefix="urn:aviutlas:test:prefix"/>
</xmp:project>
