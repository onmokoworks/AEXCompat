// PiPL identity for the origin-stating expand probe. OLGe matches this
// variant's GLOBAL_SETUP out_flags (PF_OutFlag_PIX_INDEPENDENT 1024 |
// PF_OutFlag_I_EXPAND_BUFFER 512 = 1536), and the eman/ANMe names are distinct
// from the pf-frame-resize-probe family so an effect registry keyed by match
// name does not collide them.
16000 PiPL DISCARDABLE
BEGIN
  0x0001, 0, 0x0, 12, 0x0, "MIB8", "dnik", 0, 0x0, 4, 0x0, "TKFe",
  "MIB8", "eman", 0, 0x0, 20, 0x0, "\x0fFrOrigin Expand\0\0\0\0",
  "MIB8", "gtac", 0, 0x0, 20, 0x0, "\x10AEXCompat Probes\0\0\0",
  "MIB8", "4668", 0, 0x0, 12, 0x0, "EffectMain\0\0",
  "MIB8", "RVPe", 0, 0x0, 4, 0x0, 2, 0,
  "MIB8", "RVSe", 0, 0x0, 4, 0x0, 13, 28,
  "MIB8", 0x65564552L, 0L, 4L, 1048576L,
  "MIB8", 0x65494E46L, 0L, 2L, 0L,
  "MIB8", "OLGe", 0L, 4L, 1536L,
  "MIB8", "2LGe", 0L, 4L, 0L,
  "MIB8", "ANMe", 0, 0x0, 28, 0x0, "\x18AEXCompat FrOriginExpand\0\0\0",
  "MIB8", 0x6165464CL, 0L, 4L, 0L
END
