{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aexcompat.local/contracts/aex/smartfx_suite_fault_report.schema.json",
  "schema_name": "AEXCompat SmartFX suite fault conformance report schema",
  "schema_version": 1,
  "title": "AEXCompat SmartFX suite fault conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "plugin_id", "receipt_id", "fixture_sha256", "fault_id", "expected_outcome", "expected_fallback_sha256", "run_1", "run_2", "broker_survived", "passed"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"const": "smartfx_suite_fault"},
    "plugin_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "fault_id": {"enum": ["mask_count_error", "mask_count_crash", "mask_double_dispose", "stream_dispose_with_live_value", "stream_metadata_ownership", "keyframe_ownership", "dynamic_stream_tree", "aegp_memory_strings", "suite_release_without_acquire", "handle_resize_while_locked", "world_double_dispose", "world_allocation_limit", "pixel_format_registry", "outline_mutation", "mask_attribute_ownership"]},
    "expected_outcome": {"enum": ["plugin_fallback", "worker_crash", "callback_error_rejected"]},
    "expected_fallback_sha256": {"type": ["string", "null"], "pattern": "^[0-9A-F]{64}$"},
    "run_1": {"$ref": "#/$defs/run"},
    "run_2": {"$ref": "#/$defs/run"},
    "broker_survived": {"const": true},
    "passed": {"type": "boolean"},
    "secure_launch_1": {"$ref": "#/$defs/secure_launch"},
    "secure_launch_2": {"$ref": "#/$defs/secure_launch"},
    "secure_launch_count": {"const": 2},
    "normal_token_fallback": {"const": false}
  },
  "$defs": {
    "secure_launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launch_mode", "worker_authenticated", "worker_size_bytes", "worker_sha256", "plugin_basename", "plugin_sha256", "sealed_manifest_sha256", "module_audit_required", "module_audit"],
      "properties": {
        "launch_mode": {"const": "sealed_load_tree_restricted_token"},
        "worker_authenticated": {"const": true},
        "worker_size_bytes": {"type": "integer", "minimum": 1},
        "worker_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "plugin_basename": {"type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[^\\\\/:*?\"<>|]+$"},
        "plugin_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "sealed_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "module_audit_required": {"const": true},
        "module_audit": {"type": ["object", "null"]}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "pre_render_error", "smart_render_error", "output_sha256", "guard_bytes_intact", "lifetime_fault_observed", "mask_lifetimes_balanced", "suite_fault_observed", "suite_leases_balanced", "suite_acquires", "suite_releases", "live_suite_lease_count", "live_suite_reference_count", "live_suite_leases", "handle_fault_observed", "handle_lifetimes_balanced", "handles_created", "handles_disposed", "handle_locks", "handle_unlocks", "live_handle_count", "live_handle_bytes", "invalid_handle_operations", "world_fault_observed", "world_lifetimes_balanced", "worlds_created", "worlds_disposed", "live_world_count", "live_world_bytes", "invalid_world_operations", "pixel_format_fault_observed", "pixel_format_add_calls", "pixel_format_clear_calls", "supported_pixel_format_count", "invalid_pixel_format_operations", "outline_fault_observed", "outline_mutations", "invalid_outline_operations", "mask_attribute_fault_observed", "mask_mutations", "invalid_mask_operations", "stream_metadata_fault_observed", "stream_metadata_queries", "stream_duplicates", "invalid_stream_operations", "keyframe_fault_observed", "keyframe_mutations", "invalid_keyframe_operations", "dynamic_stream_fault_observed", "dynamic_stream_queries", "dynamic_stream_mutations", "invalid_dynamic_stream_operations", "aegp_memory_fault_observed", "aegp_memory_created", "aegp_memory_freed", "live_aegp_memory_handles", "live_aegp_memory_bytes", "invalid_aegp_memory_operations"],
      "properties": {
        "classification": {"enum": ["ok", "nonzero_exit", "crashed", "timeout_killed"]},
        "pre_render_error": {"type": ["integer", "null"]},
        "smart_render_error": {"type": ["integer", "null"]},
        "output_sha256": {"type": ["string", "null"]},
        "guard_bytes_intact": {"type": ["boolean", "null"]},
        "lifetime_fault_observed": {"type": ["boolean", "null"]},
        "mask_lifetimes_balanced": {"type": ["boolean", "null"]},
        "suite_fault_observed": {"type": ["boolean", "null"]},
        "suite_leases_balanced": {"type": ["boolean", "null"]},
        "suite_acquires": {"type": ["integer", "null"], "minimum": 0},
        "suite_releases": {"type": ["integer", "null"], "minimum": 0},
        "live_suite_lease_count": {"type": ["integer", "null"], "minimum": 0},
        "live_suite_reference_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "live_suite_leases": {"type": ["string", "null"], "maxLength": 1024},
        "handle_fault_observed": {"type": ["boolean", "null"]},
        "handle_lifetimes_balanced": {"type": ["boolean", "null"]},
        "handles_created": {"type": ["integer", "null"], "minimum": 0, "maximum": 1024},
        "handles_disposed": {"type": ["integer", "null"], "minimum": 0, "maximum": 1024},
        "handle_locks": {"type": ["integer", "null"], "minimum": 0, "maximum": 4096},
        "handle_unlocks": {"type": ["integer", "null"], "minimum": 0, "maximum": 4096},
        "live_handle_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 1024},
        "live_handle_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 67108864},
        "invalid_handle_operations": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "world_fault_observed": {"type": ["boolean", "null"]},
        "world_lifetimes_balanced": {"type": ["boolean", "null"]},
        "worlds_created": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "worlds_disposed": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "live_world_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "live_world_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 268435456},
        "invalid_world_operations": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "pixel_format_fault_observed": {"type": ["boolean", "null"]},
        "pixel_format_add_calls": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "pixel_format_clear_calls": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "supported_pixel_format_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
        "invalid_pixel_format_operations": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "outline_fault_observed": {"type": ["boolean", "null"]},
        "outline_mutations": {"type": ["integer", "null"], "minimum": 0, "maximum": 256},
        "invalid_outline_operations": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "mask_attribute_fault_observed": {"type": ["boolean", "null"]},
        "mask_mutations": {"type": ["integer", "null"], "minimum": 0, "maximum": 256},
        "invalid_mask_operations": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "stream_metadata_fault_observed": {"type": ["boolean", "null"]},
        "stream_metadata_queries": {"type": ["integer", "null"], "minimum": 0, "maximum": 256},
        "stream_duplicates": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "invalid_stream_operations": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "keyframe_fault_observed": {"type": ["boolean", "null"]},
        "keyframe_mutations": {"type": ["integer", "null"], "minimum": 0, "maximum": 256},
        "invalid_keyframe_operations": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "dynamic_stream_fault_observed": {"type": ["boolean", "null"]},
        "dynamic_stream_queries": {"type": ["integer", "null"], "minimum": 0, "maximum": 512},
        "dynamic_stream_mutations": {"type": ["integer", "null"], "minimum": 0, "maximum": 256},
        "invalid_dynamic_stream_operations": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "aegp_memory_fault_observed": {"type": ["boolean", "null"]},
        "aegp_memory_created": {"type": ["integer", "null"], "minimum": 0, "maximum": 256},
        "aegp_memory_freed": {"type": ["integer", "null"], "minimum": 0, "maximum": 256},
        "live_aegp_memory_handles": {"type": ["integer", "null"], "minimum": 0, "maximum": 256},
        "live_aegp_memory_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777216},
        "invalid_aegp_memory_operations": {"type": ["integer", "null"], "minimum": 0, "maximum": 64}
      }
    }
  }
}
