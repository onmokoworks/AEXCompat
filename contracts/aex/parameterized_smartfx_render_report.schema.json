{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aexcompat.local/contracts/aex/parameterized_smartfx_render_report.schema.json",
  "schema_name": "AEXCompat parameterized SmartFX render report schema",
  "schema_version": 1,
  "title": "AEXCompat parameterized SmartFX render report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "plugin_id", "assignment_count", "accepted", "native_process_started", "passed"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"const": "parameterized_smartfx_render"},
    "plugin_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "assignment_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "host_context_mask_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 8},
    "host_context_vertex_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 128},
    "host_context_open_mask_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 8},
    "host_context_tangent_vertex_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 128},
    "accepted": {"type": "boolean"},
    "native_process_started": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "fixture_sha256": {"$ref": "#/$defs/sha256"},
    "parameters": {"$ref": "#/$defs/parameters"},
    "expected_oracle_sha256": {"$ref": "#/$defs/sha256"},
    "run_1": {"$ref": "#/$defs/run"},
    "run_2": {"$ref": "#/$defs/run"},
    "deterministic": {"type": "boolean"},
    "broker_survived": {"type": "boolean"},
    "secure_launch_1": {"$ref": "#/$defs/secure_launch"},
    "secure_launch_2": {"$ref": "#/$defs/secure_launch"},
    "secure_launch_count": {"const": 2},
    "normal_token_fallback": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"accepted": {"const": false}}},
      "then": {
        "required": ["errors"],
        "properties": {
          "native_process_started": {"const": false},
          "passed": {"const": false},
          "errors": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/error"}}
        }
      }
    },
    {
      "if": {"properties": {"accepted": {"const": true}}},
      "then": {
        "required": ["receipt_id", "fixture_sha256", "parameters", "expected_oracle_sha256", "run_1", "run_2", "deterministic", "broker_survived"],
        "properties": {"native_process_started": {"const": true}}
      }
    },
    {
      "if": {"properties": {"passed": {"const": true}}},
      "then": {
        "properties": {
          "accepted": {"const": true},
          "native_process_started": {"const": true},
          "deterministic": {"const": true},
          "broker_survived": {"const": true},
          "run_1": {"$ref": "#/$defs/success_run"},
          "run_2": {"$ref": "#/$defs/success_run"}
        }
      }
    }
  ],
  "$defs": {
    "secure_launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launch_mode", "worker_authenticated", "worker_size_bytes", "worker_sha256", "plugin_basename", "plugin_sha256", "sealed_manifest_sha256", "module_audit_required", "module_audit"],
      "properties": {
        "launch_mode": {"const": "sealed_load_tree_restricted_token"},
        "worker_authenticated": {"const": true},
        "worker_size_bytes": {"type": "integer", "minimum": 1},
        "worker_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "plugin_basename": {"type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[^\\\\/:*?\"<>|]+$"},
        "plugin_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "sealed_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "module_audit_required": {"const": true},
        "module_audit": {"type": ["object", "null"]}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "parameter", "valid_min", "valid_max"],
      "properties": {
        "code": {"enum": ["invalid_parameter_value", "parameter_out_of_range"]},
        "parameter": {"type": "string", "minLength": 1, "maxLength": 63},
        "valid_min": {"type": "number"},
        "valid_max": {"type": "number"}
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/color"}]}
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "pre_render_error", "smart_render_error", "output_sha256", "result_rects_valid", "guard_bytes_intact", "request_mode", "mask_scene_id", "mask_count", "mask_open_count", "mask_tangent_vertex_count", "mask_lifetimes_balanced", "mask_handles_acquired", "mask_handles_disposed", "stream_handles_acquired", "stream_handles_disposed", "stream_values_acquired", "stream_values_disposed", "suite_leases_balanced", "suite_acquires", "suite_releases", "live_suite_lease_count", "live_suite_reference_count", "live_suite_leases", "handle_lifetimes_balanced", "handles_created", "handles_disposed", "handle_locks", "handle_unlocks", "live_handle_count", "live_handle_bytes", "invalid_handle_operations", "requested_parameters"],
      "properties": {
        "classification": {"enum": ["ok", "nonzero_exit", "crashed", "timeout_killed"]},
        "pre_render_error": {"type": ["integer", "null"]},
        "smart_render_error": {"type": ["integer", "null"]},
        "output_sha256": {"type": ["string", "null"]},
        "result_rects_valid": {"type": ["boolean", "null"]},
        "guard_bytes_intact": {"type": ["boolean", "null"]},
        "request_mode": {"type": ["boolean", "null"]},
        "mask_scene_id": {"type": ["string", "null"], "maxLength": 64},
        "mask_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 8},
        "mask_open_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 8},
        "mask_tangent_vertex_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 128},
        "mask_lifetimes_balanced": {"type": ["boolean", "null"]},
        "mask_handles_acquired": {"type": ["integer", "null"], "minimum": 0},
        "mask_handles_disposed": {"type": ["integer", "null"], "minimum": 0},
        "stream_handles_acquired": {"type": ["integer", "null"], "minimum": 0},
        "stream_handles_disposed": {"type": ["integer", "null"], "minimum": 0},
        "stream_values_acquired": {"type": ["integer", "null"], "minimum": 0},
        "stream_values_disposed": {"type": ["integer", "null"], "minimum": 0},
        "suite_leases_balanced": {"type": ["boolean", "null"]},
        "suite_acquires": {"type": ["integer", "null"], "minimum": 0},
        "suite_releases": {"type": ["integer", "null"], "minimum": 0},
        "live_suite_lease_count": {"type": ["integer", "null"], "minimum": 0},
        "live_suite_reference_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "live_suite_leases": {"type": ["string", "null"], "maxLength": 1024},
        "handle_lifetimes_balanced": {"type": ["boolean", "null"]},
        "handles_created": {"type": ["integer", "null"], "minimum": 0, "maximum": 1024},
        "handles_disposed": {"type": ["integer", "null"], "minimum": 0, "maximum": 1024},
        "handle_locks": {"type": ["integer", "null"], "minimum": 0, "maximum": 4096},
        "handle_unlocks": {"type": ["integer", "null"], "minimum": 0, "maximum": 4096},
        "live_handle_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 1024},
        "live_handle_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 67108864},
        "invalid_handle_operations": {"type": ["integer", "null"], "minimum": 0, "maximum": 64},
        "requested_parameters": {"type": ["array", "null"], "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/requested_parameter"}}
      }
    },
    "requested_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slot", "kind", "value"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "slot": {"type": "integer", "minimum": 1, "maximum": 64},
        "kind": {"enum": ["integer", "float", "color"]},
        "value": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/color"}]}
      }
    },
    "color": {
      "type": "object", "additionalProperties": false,
      "required": ["alpha", "red", "green", "blue"],
      "properties": {
        "alpha": {"type": "integer", "minimum": 0, "maximum": 255},
        "red": {"type": "integer", "minimum": 0, "maximum": 255},
        "green": {"type": "integer", "minimum": 0, "maximum": 255},
        "blue": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "success_run": {
      "allOf": [
        {"$ref": "#/$defs/run"},
        {
          "properties": {
            "classification": {"const": "ok"},
            "pre_render_error": {"const": 0},
            "smart_render_error": {"const": 0},
            "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "result_rects_valid": {"const": true},
            "guard_bytes_intact": {"const": true},
            "request_mode": {"const": true},
            "mask_lifetimes_balanced": {"const": true},
            "handle_lifetimes_balanced": {"const": true},
            "live_handle_count": {"const": 0},
            "live_handle_bytes": {"const": 0},
            "invalid_handle_operations": {"const": 0},
            "requested_parameters": {"type": "array", "minItems": 1}
          }
        }
      ]
    }
  }
}
