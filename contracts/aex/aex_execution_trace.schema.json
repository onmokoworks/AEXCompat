{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onmokoworks.local/aexcompat/aex_execution_trace.schema.json",
  "title": "AEXCompat x64 AEX execution trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "execution_backend",
    "image_sha256",
    "preferred_image_base",
    "entry_export",
    "selector",
    "entry_rva",
    "return_value",
    "truncated",
    "events",
    "functions",
    "state_changes",
    "timeline"
  ],
  "properties": {
    "schema": { "const": "aexcompat.aex-execution-trace" },
    "schema_version": { "const": 1 },
    "execution_backend": { "type": "string", "minLength": 1 },
    "image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preferred_image_base": { "type": "integer", "minimum": 0 },
    "entry_export": { "type": "string", "minLength": 1 },
    "selector": {
      "enum": [
        "GLOBAL_SETUP",
        "PARAMS_SETUP",
        "SEQUENCE_SETUP",
        "FRAME_SETUP",
        "RENDER",
        "SMART_PRE_RENDER",
        "SMART_RENDER",
        "FRAME_SETDOWN",
        "SEQUENCE_SETDOWN"
      ]
    },
    "entry_rva": { "type": "integer", "minimum": 0 },
    "return_value": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" },
    "events": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/event" }
    },
    "functions": {
      "type": "array",
      "items": { "$ref": "#/$defs/function" }
    },
    "state_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/state_change" }
    },
    "memory_witnesses": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/memory_witness" }
    },
    "dropped_memory_witnesses": { "type": "integer", "minimum": 0 },
    "basic_blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/basic_block" }
    },
    "branch_edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/branch_edge" }
    },
    "timeline": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "observed_count", "depth", "kind"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "observed_count": { "type": "integer", "minimum": 1 },
        "depth": { "type": "integer", "minimum": 0 },
        "call_id": { "type": "integer", "minimum": 1 },
        "function_rva": { "type": "integer", "minimum": 0 },
        "kind": {
          "enum": [
            "selector_enter",
            "selector_exit",
            "guest_call",
            "guest_return",
            "import_call",
            "host_callback",
            "tail_call",
            "rip_constant"
          ]
        },
        "pc_rva": { "type": "integer", "minimum": 0 },
        "target_rva": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "call_kind": { "enum": ["direct", "indirect", "runtime_jmp"] },
        "instruction_bytes": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{2})+$"
        },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/argument" }
        },
        "xmm_arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/xmm_value" }
        },
        "stack_arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/stack_argument" }
        },
        "return_value": {
          "$ref": "#/$defs/return_value"
        },
        "exemplars": {
          "$ref": "#/$defs/exemplars"
        }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "raw", "classification"],
      "properties": {
        "register": { "enum": ["rcx", "rdx", "r8", "r9"] },
        "raw": { "type": "integer", "minimum": 0 },
        "classification": {
          "enum": ["scalar", "image", "guest_data", "guest_stack", "host_stub"]
        },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    "xmm_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "raw_hex", "f32_lanes", "f64_lanes"],
      "properties": {
        "register": { "enum": ["xmm0", "xmm1", "xmm2", "xmm3"] },
        "raw_hex": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "f32_lanes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": ["number", "null"] }
        },
        "f64_lanes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": ["number", "null"] }
        }
      }
    },
    "stack_argument": {
      "allOf": [
        { "$ref": "#/$defs/value" },
        {
          "type": "object",
          "required": ["index", "stack_offset"],
          "properties": {
            "index": { "type": "integer", "minimum": 5 },
            "stack_offset": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "return_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rax", "xmm0"],
      "properties": {
        "rax": { "$ref": "#/$defs/value" },
        "xmm0": { "$ref": "#/$defs/xmm_value" }
      }
    },
    "exemplars": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct_fingerprints",
        "dropped_distinct_fingerprints",
        "first",
        "last",
        "distinct",
        "numeric_ranges"
      ],
      "properties": {
        "distinct_fingerprints": { "type": "integer", "minimum": 0 },
        "dropped_distinct_fingerprints": { "type": "integer", "minimum": 0 },
        "first": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/observation" }
        },
        "last": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/observation" }
        },
        "distinct": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/observation" }
        },
        "numeric_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "minimum", "maximum"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "minimum": { "type": "number" },
              "maximum": { "type": "number" }
            }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation",
        "fingerprint",
        "arguments",
        "xmm_arguments",
        "stack_arguments"
      ],
      "properties": {
        "observation": { "type": "integer", "minimum": 1 },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "call_id": { "type": "integer", "minimum": 1 },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/argument" }
        },
        "xmm_arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/xmm_value" }
        },
        "stack_arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/stack_argument" }
        },
        "return_value": { "$ref": "#/$defs/return_value" }
      }
    },
    "value": {
      "type": "object",
      "required": ["raw", "classification"],
      "properties": {
        "raw": { "type": "integer", "minimum": 0 },
        "classification": {
          "enum": ["scalar", "image", "guest_data", "guest_stack", "host_stub"]
        },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_rva",
        "entry_bytes",
        "observed_calls",
        "observed_returns",
        "callees",
        "imports",
        "host_callbacks"
      ],
      "properties": {
        "entry_rva": { "type": "integer", "minimum": 0 },
        "entry_bytes": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{2})*$"
        },
        "observed_calls": { "type": "integer", "minimum": 0 },
        "observed_returns": { "type": "integer", "minimum": 0 },
        "callees": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "imports": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "host_callbacks": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "state_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "before", "after"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "before": { "type": "string" },
        "after": { "type": "string" }
      }
    },
    "memory_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "watch_id",
        "call_id",
        "register",
        "before",
        "after",
        "changed_ranges"
      ],
      "properties": {
        "watch_id": { "type": "string", "minLength": 1 },
        "call_id": { "type": "integer", "minimum": 1 },
        "function_rva": { "type": "integer", "minimum": 0 },
        "pc_rva": { "type": "integer", "minimum": 0 },
        "register": {
          "enum": [
            "rax",
            "rcx",
            "rdx",
            "r8",
            "r9",
            "stack5",
            "stack6",
            "stack7",
            "stack8"
          ]
        },
        "before": { "$ref": "#/$defs/memory_snapshot" },
        "after": { "$ref": "#/$defs/memory_snapshot" },
        "changed_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offset", "size"],
            "properties": {
              "offset": { "type": "integer", "minimum": 0 },
              "size": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "memory_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "address", "size", "classification"],
      "properties": {
        "status": { "enum": ["captured", "unmapped", "oversized"] },
        "address": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "classification": {
          "enum": ["scalar", "image", "guest_data", "guest_stack", "host_stub"]
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "hex": { "type": "string", "pattern": "^(?:[a-f0-9]{2})*$" },
        "u8_values": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "u16_values": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
        },
        "u32_values": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        },
        "u64_values": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "integer", "minimum": 0 }
        },
        "f32_values": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": ["number", "null"] }
        },
        "f64_values": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": ["number", "null"] }
        },
        "pointer_chain": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "classification"],
            "properties": {
              "address": { "type": "integer", "minimum": 0 },
              "classification": {
                "enum": [
                  "scalar",
                  "image",
                  "guest_data",
                  "guest_stack",
                  "host_stub"
                ]
              }
            }
          }
        }
      }
    },
    "basic_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rva", "size", "observed_count"],
      "properties": {
        "rva": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 1 },
        "observed_count": { "type": "integer", "minimum": 1 }
      }
    },
    "branch_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_rva", "to_rva", "observed_count"],
      "properties": {
        "from_rva": { "type": "integer", "minimum": 0 },
        "to_rva": { "type": "integer", "minimum": 0 },
        "observed_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
