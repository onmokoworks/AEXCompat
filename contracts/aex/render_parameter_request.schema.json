{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aexcompat.local/contracts/aex/render_parameter_request.schema.json",
  "schema_name": "AEXCompat render parameter request schema",
  "schema_version": 2,
  "title": "AEXCompat render parameter request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin_id", "assignments"],
  "properties": {
    "schema_version": {"const": 2},
    "plugin_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "assignments": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {"type": "number"}
    }
  }
}
