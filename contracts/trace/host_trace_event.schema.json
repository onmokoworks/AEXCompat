{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aexcompat.local/contracts/trace/host_trace_event.schema.json",
  "schema_version": 1,
  "title": "AEXCompat host trace event",
  "type": "object",
  "required": ["schema_version", "event_index", "event_kind", "host_kind", "host_version_label", "plugin_label"],
  "properties": {
    "schema_version": {"const": 1},
    "event_index": {"type": "integer", "minimum": 0},
    "event_kind": {
      "enum": ["session_start", "selector_dispatch", "suite_acquire", "suite_release", "callback_invoke", "world_descriptor", "error", "unimplemented", "session_end"]
    },
    "host_kind": {"enum": ["after_effects_manual", "minihost"]},
    "host_version_label": {"type": "string", "minLength": 1, "not": {"pattern": "^[A-Za-z]:\\\\"}},
    "plugin_label": {"type": "string", "minLength": 1, "pattern": "^[^\\\\/:]+$"},
    "selector": {"type": "string", "minLength": 1, "not": {"pattern": "^[A-Za-z]:\\\\"}},
    "suite": {
      "type": "object",
      "required": ["name", "version", "granted"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "not": {"pattern": "^[A-Za-z]:\\\\"}},
        "version": {"type": "integer", "minimum": 0},
        "granted": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "world": {
      "type": "object",
      "required": ["width", "height", "rowbytes", "pixel_format"],
      "properties": {
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0},
        "rowbytes": {"type": "integer", "minimum": 0},
        "pixel_format": {"enum": ["argb8", "argb16", "argb32f", "rgba8", "unknown"]}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code_label", "message"],
      "properties": {
        "code_label": {"type": "string", "minLength": 1, "not": {"pattern": "^[A-Za-z]:\\\\"}},
        "message": {"type": "string", "not": {"pattern": "(^|[^A-Za-z])[A-Za-z]:\\\\"}}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"event_kind": {"const": "selector_dispatch"}}}, "then": {"required": ["selector"]}},
    {"if": {"properties": {"event_kind": {"enum": ["suite_acquire", "suite_release"]}}}, "then": {"required": ["suite"]}},
    {"if": {"properties": {"event_kind": {"const": "world_descriptor"}}}, "then": {"required": ["world"]}},
    {"if": {"properties": {"event_kind": {"enum": ["error", "unimplemented"]}}}, "then": {"required": ["error"]}}
  ],
  "additionalProperties": false
}
